[Unit]
Description=Personal blog lesson generation and independent delivery
Wants=network-online.target
After=network-online.target
ConditionPathExists=/srv/personal-blog/lesson-runner/schedule.json

[Service]
Type=oneshot
User=65532
Group=65532
UMask=0077
EnvironmentFile=/srv/personal-blog/secrets/lesson-runner.env
ExecStart=/opt/personal-blog/runner/publisher schedule --input /srv/personal-blog/lesson-runner/schedule.json --state-dir /srv/personal-blog/lesson-runner/state
TimeoutStartSec=11min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/personal-blog/lesson-runner/state
MemoryMax=256M
TasksMax=32
