<!doctype html>
<html lang="{{.Locale}}" dir="{{.Direction}}"><head>{{.Head}}</head><body data-rendered="server" data-public-theme="{{.ThemeID}}">
<div class="vb public-site">
<a class="vb-skip" href="#content">{{.SkipLabel}}</a>
<div class="vb-shell">
{{range .Layout}}{{if eq . "header"}}{{template "page-header" $}}{{else if eq . "content"}}{{template "page-content" $}}{{else if eq . "footer"}}{{template "page-footer" $}}{{else if eq . "banner"}}<img class="public-banner" src="{{$.BannerURL}}" alt="">{{end}}{{end}}

</div>
</div>
</body></html>

{{define "page-header"}}
<header class="vb-header public-header">
<a class="vb-brand" href="{{.Brand.HomeURL}}" dir="auto">{{if eq .Brand.Kind "image"}}<img src="{{.Brand.ImageURL}}" alt="{{.Brand.ImageAlt}}">{{else if eq .Brand.Kind "monogram"}}<span class="vb-mono">{{.Brand.Monogram}}</span>{{else if .Brand.Split}}{{.Brand.Pre}}<span>.</span>{{.Brand.Suf}}{{else}}{{.Brand.Text}}{{end}}</a>
{{if .Nav}}<nav class="vb-nav public-nav" aria-label="{{.NavLabel}}">
{{- range .Nav}}{{template "page-menu-link" .}}{{end -}}
</nav>{{end}}
<div class="vb-tools public-tools">
<a class="vb-icon" href="{{.SearchURL}}" aria-label="{{.SearchLabel}}">{{template "public-icon" "search"}}</a>
{{if gt (len .Languages) 1}}<details class="public-details">
<summary class="vb-icon public-language" aria-label="{{.LanguageLabel}}" aria-controls="language-menu">{{.LanguageShort}}</summary>
<div class="public-menu" id="language-menu"><nav aria-label="{{.LanguageLabel}}">
{{- range .Languages}}<a href="{{.URL}}" lang="{{.Code}}" dir="{{.Dir}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a>{{end -}}
</nav></div>
</details>{{end}}
{{if .ThemeLabel}}<button type="button" class="vb-icon" aria-label="{{.ThemeLabel}}" data-theme-toggle hidden>{{template "public-icon" "moon"}}</button>{{end}}
{{if .MenuNav}}<details class="public-details">
<summary class="vb-icon vb-menu" aria-label="{{.MenuLabel}}" aria-controls="navigation-menu">{{template "public-icon" "menu"}}</summary>
<div class="public-menu" id="navigation-menu"><nav aria-label="{{.NavLabel}}">
{{- range .MenuNav}}{{template "page-menu-link" .}}{{end -}}
</nav></div>
</details>{{end}}
</div>
</header>
{{end}}
{{define "page-menu-link"}}{{if .Children}}<div class="public-nav-group">{{end}}<a href="{{.URL}}"{{if .Current}} aria-current="page"{{end}}{{if .Language}} lang="{{.Language}}" dir="auto"{{end}}>{{.Label}}</a>{{if .Children}}<ul class="public-nav-children">{{range .Children}}<li>{{template "page-menu-link" .}}</li>{{end}}</ul></div>{{end}}{{end}}
{{define "page-content"}}
<main id="content" tabindex="-1" class="public-main{{if not .Article}} public-themed-index{{end}}">
{{if .Error}}<section class="public-section"><h1 class="vb-title">{{.Error}}</h1><a class="vb-link" href="{{.Brand.HomeURL}}">{{.HomeLabel}}</a></section>{{else if .Article}}{{template "public-article" .Article}}{{else if .Home}}{{template "public-home" .Home}}{{else if .About}}{{template "public-about" .About}}{{else if .Discovery}}{{template "public-discovery" .Discovery}}{{else if .Reading}}{{template "public-reading" .Reading}}{{end}}
</main>
{{end}}
{{define "page-footer"}}
<footer class="vb-footer">
{{- with .Footer}}
{{range .Projections}}<p dir="auto">{{.}}</p>{{end}}
{{if .Text}}<p class="big" dir="auto">{{.Text}}</p>{{else if .Email}}<p class="big">{{.Question}} <a href="mailto:{{.Email}}">{{.SayHi}}</a></p>{{end}}
<div class="row">
<span class="vb-meta">{{if .Copyright}}© {{.Copyright}}{{end}}</span>
{{if .Links}}<nav aria-label="{{.NavLabel}}">
{{- range .Links}}{{template "page-menu-link" .}}{{end -}}
</nav>{{end}}
</div>
{{- end}}
</footer>
{{end}}
