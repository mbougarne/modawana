{
  "name": "personal-blog-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.23.4",
    "npm": "10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.cjs",
    "lint": "node ../scripts/quality.mjs lint",
    "lint:fix": "node ../scripts/quality.mjs lint --fix",
    "format": "node ../scripts/quality.mjs format --fix",
    "format:check": "node ../scripts/quality.mjs format"
  },
  "dependencies": {
    "katex": "0.19.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "css-loader": "7.1.5",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "html-webpack-plugin": "5.6.8",
    "jsdom": "26.1.0",
    "mini-css-extract-plugin": "2.10.2",
    "playwright": "1.58.2",
    "prettier": "3.9.10",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "webpack": "5.110.3",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "6.1.0"
  },
  "overrides": {
    "katex": "$katex",
    "minimatch": "11.0.1"
  },
  "license": "MIT"
}
